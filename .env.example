# HuggingFace authentication (for gated models like ghana-tts-72k)
HF_TOKEN=

# Khaya AI API key (for the Khaya TTS v2 hosted model)
KHAYA_API_KEY=

# Number of text samples per language (default: 200).
# Runs are incremental — bumping this only scores the new sentences.
NSANKU_TTS_NUM_SAMPLES=200

# Alignment backend: python (default) or ctc_forced_aligner
ALIGNMENT_BACKEND=python